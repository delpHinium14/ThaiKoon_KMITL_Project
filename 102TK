# --------------------------- ค่าที่ต้องปรับ (หน่วย px ที่ภาพกว้าง 1280) ---------------------------
@dataclass
class Config:
    work_size: int = 1280         # ย่อ/ขยายภาพให้ด้านยาว = ค่านี้ เพื่อให้ threshold ใช้ได้เท่ากันทุกภาพ
    height_tol: float = 15.0      # |dy| เกินนี้ = สูง-ต่ำ NG
    center_tol: float = 30.0      # รอยบากเยื้องจากแกนกลางโซ่เกินนี้ = สั้น-ยาว NG   (ตอนนี้ปรับจากตัวอย่างอย่างละ 1 ภาพ!)
    link_width: float = 1100.0    # ความกว้างโซ่โดยประมาณ (ใช้คำนวณ % และวาดกรอบเท่านั้น)
    min_notch_score: float = 3.0  # ความมั่นใจขั้นต่ำของการหารอยบาก
    min_dy_corr: float = 0.20     # ความมั่นใจขั้นต่ำของการวัดสูง-ต่ำ
    min_sym_corr: float = 0.08    # ความมั่นใจขั้นต่ำของการหาแกนสมมาตร


@dataclass
class Measure:
    img: np.ndarray
    notch_x: int = 0
    notch_top: int = 0
    notch_score: float = 0.0
    dy: float = 0.0               # + = ฝั่งขวาของรอยบากต่ำกว่าฝั่งซ้าย
    dy_corr: float = 0.0
    axis_x: float = 0.0           # แกนกลางของโซ่ (จากความสมมาตร)
    sym_corr: float = 0.0


# ------------------------------------------- 1) วัด -------------------------------------------
def find_notch(gray, cfg):
    H, W = gray.shape
    g = cv2.GaussianBlur(gray, (5, 5), 0)
    bh = cv2.morphologyEx(g, cv2.MORPH_BLACKHAT, cv2.getStructuringElement(cv2.MORPH_RECT, (31, 1)))
    bh = cv2.morphologyEx(bh, cv2.MORPH_OPEN, cv2.getStructuringElement(cv2.MORPH_RECT, (1, int(H * 0.04))))
    roi = np.zeros_like(bh)
    roi[int(.2 * H):int(.6 * H), int(.25 * W):int(.75 * W)] = 1
    bh = bh * roi
    prof = cv2.GaussianBlur(bh.sum(0).astype(np.float32).reshape(1, -1), (0, 0), 3).ravel()
    x = int(prof.argmax())
    score = float(prof[x] / (np.median(prof[prof > 0]) + 1e-6)) if (prof > 0).any() else 0.0
    ys = np.where(bh[:, x] > 20)[0]
    return x, (int(ys.min()) if len(ys) else int(.3 * H)), score


def measure_height_shift(gray, x0):
    """เลื่อนแนวตั้ง (px) ที่ทำให้ลายของแถบซ้ายกับแถบขวาของรอยบากตรงกันที่สุด"""
    g = cv2.GaussianBlur(gray.astype(np.float32), (0, 0), 2)
    y1, y2, R = 150, 650, 40
    ests = []
    for a, b in [(18, 50), (18, 70), (25, 90)]:
        dl = np.gradient(g[:, x0 - b:x0 - a].mean(1))
        dr = np.gradient(g[:, x0 + a:x0 + b].mean(1))
        sc = np.array([np.corrcoef(dl[y1:y2], dr[y1 + d:y2 + d])[0, 1] for d in range(-R, R + 1)])
        k = int(np.nan_to_num(sc, nan=-1).argmax())
        ests.append((k - R, float(sc[k])))
    return float(np.median([e[0] for e in ests])), float(np.median([e[1] for e in ests]))


def find_symmetry_axis(gray, x0, y_top, search=120):
    """แกนกลางโซ่ = ตำแหน่งที่ขอบซ้าย/ขวาของส่วนโค้งบนสะท้อนกันมากที่สุด"""
    H, W = gray.shape
    gs = cv2.GaussianBlur(gray.astype(np.float32), (0, 0), 3)
    E = np.hypot(cv2.Sobel(gs, cv2.CV_32F, 1, 0), cv2.Sobel(gs, cv2.CV_32F, 0, 1))
    E = np.clip(E - np.median(E, axis=1, keepdims=True), 0, None)     # ตัดลายแถบแนวนอนของพื้นหลังออก
    ya, yb = min(H - 2, y_top + 40), min(H - 1, y_top + 200)
    Eb = E[ya:yb]
    ds = np.arange(150, 510, 3)
    best = (x0, -1.0)
    for c in range(x0 - search, x0 + search + 1, 2):
        if c - ds.max() < 0 or c + ds.max() >= W:
            continue
        l, r = Eb[:, c - ds], Eb[:, c + ds]
        l = (l - l.mean()) / (l.std() + 1e-6); r = (r - r.mean()) / (r.std() + 1e-6)
        s = float((l * r).mean())
        if s > best[1]:
            best = (c, s)
    return float(best[0]), best[1]


def detect(bgr, cfg=Config()):
    s = cfg.work_size / max(bgr.shape[:2])
    img = cv2.resize(bgr, None, fx=s, fy=s, interpolation=cv2.INTER_AREA) if abs(s - 1) > 1e-3 else bgr.copy()
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    m = Measure(img=img)
    m.notch_x, m.notch_top, m.notch_score = find_notch(gray, cfg)
    m.dy, m.dy_corr = measure_height_shift(gray, m.notch_x)
    m.axis_x, m.sym_corr = find_symmetry_axis(gray, m.notch_x, m.notch_top)
    return m


# ------------------------------------------- 2) ตัดสิน -------------------------------------------
def evaluate(m, cfg=Config()):
    r = dict(dy=m.dy, offset_px=m.notch_x - m.axis_x, notes=[])
    r["offset_pct"] = 100.0 * r["offset_px"] / cfg.link_width
    if m.notch_score < cfg.min_notch_score:
        r.update(type=0, label="UNDETECTED : หารอยบากไม่พบ"); return r
    r["height_ng"] = abs(m.dy) > cfg.height_tol
    r["length_ng"] = abs(r["offset_px"]) > cfg.center_tol
    if m.dy_corr < cfg.min_dy_corr:
        r["notes"].append("ความมั่นใจการวัดสูง-ต่ำต่ำ")
    if m.sym_corr < cfg.min_sym_corr:
        r["notes"].append("ความมั่นใจการหาแกนกลางโซ่ต่ำ (ไม่ตัดสินสั้น-ยาว)")
        r["length_ng"] = False
    if r["height_ng"]:
        r.update(type=3, label="ประเภท 3 : NG สูง-ต่ำ")
    elif r["length_ng"]:
        r.update(type=2, label="ประเภท 2 : NG สั้น-ยาว")
    else:
        r.update(type=1, label="ประเภท 1 : OK")
    return r


# ------------------------------------------- 3) วาดผล -------------------------------------------
GREEN, RED, BLUE, ORANGE, WHITE = (0, 200, 0), (0, 0, 255), (255, 128, 0), (0, 140, 255), (255, 255, 255)
FONT = cv2.FONT_HERSHEY_SIMPLEX

def draw(m, r, cfg=Config()):
    o = m.img.copy(); H, W = o.shape[:2]
    if r["type"] == 0:
        cv2.rectangle(o, (0, 0), (W, 78), (60, 60, 60), -1)
        cv2.putText(o, "UNDETECTED", (20, 52), FONT, 1.5, WHITE, 3); return o
    x0, y0 = m.notch_x, m.notch_top + 10
    top, bot = m.notch_top - 120, m.notch_top + 250

    # --- สั้น-ยาว: กรอบ+เส้นกลางโซ่ (ฟ้า) เทียบกับตำแหน่งรอยบาก (เขียว=ปกติ / แดง=เยื้อง)
    sym_ok = m.sym_corr >= cfg.min_sym_corr
    ax = int(m.axis_x if sym_ok else x0); hw = int(cfg.link_width / 2)
    cv2.rectangle(o, (ax - hw, top), (ax + hw, bot), BLUE, 3)
    cv2.line(o, (ax, top), (ax, bot), BLUE, 2)
    cv2.line(o, (x0, top - 15), (x0, bot), RED if r["length_ng"] else GREEN, 3)
    if r["length_ng"]:
        cv2.arrowedLine(o, (ax, bot + 28), (x0, bot + 28), ORANGE, 5, tipLength=0.35)
        cv2.putText(o, f"off-center {r['offset_px']:+.0f}px ({r['offset_pct']:+.1f}%)",
                    (min(ax, x0) - 40, bot + 68), FONT, 0.9, ORANGE, 2)

    # --- สูง-ต่ำ: จุดแดง 4 จุด + เส้นเขียว (ฝั่งซ้ายที่ระดับอ้างอิง, ฝั่งขวาเลื่อนตาม dy)
    xs = [x0 - 230, x0 - 35, x0 + 35, x0 + 230]
    ys = [y0, y0, int(y0 + m.dy), int(y0 + m.dy)]
    line_col = RED if r["height_ng"] else GREEN
    cv2.line(o, (xs[0], ys[0]), (xs[1], ys[1]), line_col, 3)
    cv2.line(o, (xs[2], ys[2]), (xs[3], ys[3]), line_col, 3)
    cv2.line(o, (xs[1], ys[1]), (xs[2], ys[2]), line_col, 3)
    for p in zip(xs, ys):
        cv2.circle(o, p, 9, RED, -1)
    if r["height_ng"]:
        cv2.line(o, (xs[0], y0), (xs[3], y0), GREEN, 1)                      # ระดับที่ควรจะเป็น
        cv2.arrowedLine(o, (xs[3] + 20, y0), (xs[3] + 20, int(y0 + m.dy)), ORANGE, 4, tipLength=0.3)
        cv2.putText(o, f"height diff {m.dy:+.0f}px", (xs[3] - 190, int(y0 + max(m.dy, 0)) + 45), FONT, 0.9, ORANGE, 2)

    ok = r["type"] == 1
    cv2.rectangle(o, (0, 0), (W, 78), (0, 120, 0) if ok else (0, 0, 200), -1)
    cv2.putText(o, f"TYPE {r['type']}  {'OK' if ok else 'NG'}", (20, 52), FONT, 1.5, WHITE, 3)
    off = f"{r['offset_px']:+.0f}px" if sym_ok else "n/a"
    cv2.putText(o, f"dy={m.dy:+.0f}px  offset={off}", (W - 560, 52), FONT, 1.0, WHITE, 2)
    return o


# ------------------------------------------- รันจริง -------------------------------------------
def process_files(inputs, out_dir, cfg=Config()):
    files = []
    for p in inputs:
        if os.path.isdir(p):
            files += sorted(glob.glob(os.path.join(p, "*")))
        else:
            files.append(p)
    files = [f for f in files if f.lower().endswith((".jpg", ".jpeg", ".png", ".bmp"))]

    if not files:
        print("⚠ ไม่พบไฟล์รูปภาพจาก path ที่ให้มา กรุณาตรวจสอบ INPUT_PATH / INPUT_PATHS ในโค้ดอีกครั้ง")
        return

    os.makedirs(out_dir, exist_ok=True)
    for fp in files:
        bgr = cv2.imread(fp)
        if bgr is None:
            print("อ่านไฟล์ไม่ได้ (path ผิด หรือไฟล์เสีย):", fp)
            continue
        m = detect(bgr, cfg); r = evaluate(m, cfg)
        out_path = os.path.join(out_dir, "result_" + os.path.basename(fp))
        cv2.imwrite(out_path, draw(m, r, cfg))
        print(f"{os.path.basename(fp):26s} {r['label']:24s} dy={r['dy']:+6.1f}px (corr {m.dy_corr:.2f})  "
              f"offset={r['offset_px']:+6.1f}px (corr {m.sym_corr:.2f})  {'; '.join(r['notes'])}")
        print(f"   -> บันทึกผลที่ {out_path}")


def main():
    # ----- โหมดที่ 1: รันแบบดับเบิลคลิก/กด Run ใน VS Code โดยไม่ใส่ argument -----
    # ถ้าไม่มี argument ส่งมาตอนรัน (sys.argv มีแค่ชื่อไฟล์) จะใช้ INPUT_PATH / INPUT_PATHS ที่กำหนดไว้ด้านบนแทน
    import sys
    if len(sys.argv) == 1:
        inputs = INPUT_PATHS if INPUT_PATHS else [INPUT_PATH]
        process_files(inputs, OUTPUT_DIR)
        return

    # ----- โหมดที่ 2: รันผ่านบรรทัดคำสั่ง (ของเดิม) -----
    ap = argparse.ArgumentParser()
    ap.add_argument("inputs", nargs="+")
    ap.add_argument("-o", "--out", default="results")
    ap.add_argument("--height-tol", type=float)
    ap.add_argument("--center-tol", type=float)
    a = ap.parse_args()
    cfg = Config()
    if a.height_tol is not None: cfg.height_tol = a.height_tol
    if a.center_tol is not None: cfg.center_tol = a.center_tol
    process_files(a.inputs, a.out, cfg)


if __name__ == "__main__":
    main()